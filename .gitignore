dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ===== Vercel deployment: exclude large/local-only files =====

# Database file (SQLite local dev — won't work on Vercel anyway)
/db/
*.db
*.db-journal

# Upload staging area (original downloaded files, not part of the app)
/upload/

# Temp upload chunks (chunked music upload staging)
/tmp-uploads/

# User-uploaded songs (per-user subdirectories under public/audio/)
# Keep the 3 built-in songs (directly in public/audio/) but ignore user uploads
public/audio/*/
!public/audio/midnight-reverie.mp3
!public/audio/soft-focus.mp3
!public/audio/deep-work.mp3

# Test screenshots (not part of the app)
/tests/

# Agent context files
/agent-ctx/

# z-scripts
/.zscripts/

# Tool results
/tool-results/

# Screenshots in upload folder
upload/**/*.png
upload/**/*.zip
upload/**/*.tar
upload/**/*.mp3

# Build artifacts / ship zips — not part of source control
public/*.zip
public/*.tar.gz
# Kilo Code worktree artifacts (contains AI assistant logs that may include secrets)
.kilo/

# Kilo Code worktree artifacts (contains AI assistant logs that may include secrets)
.kilo/

# Kilo Code worktree artifacts (contains AI assistant logs that may include secrets)
.kilo/

.kilo/
